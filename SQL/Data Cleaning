-- Adding custome column
-- aug_train_data
-- 1. Experience_group column
Alter table aug_train_data
Add column Experience_group varchar(20);

Update aug_train_data
set Experience_group =
CASE
When Experience <5 then 'Junior'
When Experience between 5 and 10 then 'Mid'
else 'Senior'
End;

-- 2. Training_hours_level
Alter table aug_train_data
Add column Training_hours_level varchar(20);

Update aug_train_data
set Training_hours_level =
Case
When training_hours <100 then 'Low'
When training_hours between 100 and 200 then 'Medium'
else 'High'
End;

-- 3. city_development_level column
Alter table aug_train_data
add column city_development_level varchar(40);

Update aug_train_data
set city_development_level =
Case
When city_development_index <0.5 then 'Low development'
When city_development_index between 0.5 and 0.7 then 'Moderately developed city'
else 'Highly developed city'
end;
