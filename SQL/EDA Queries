-- Exploratory Data Analysis (EDA) - Aug_Train_Dataset
-- Total count of Job_change Vs No_change'
select * from aug_train_data;
select target, count(*) as Total_count,
round(count(*)/(select count(*) from aug_train_data)*100,2)  as Job_change_per
from aug_train_data
group by target;

-- Top_10 Cities Vs Job_change
Select City, 
count(*) as Total_candidates,
sum(target) as Job_change,
round(avg(target)*100,2) as Job_change_rate
from aug_train_data
group by city
order by round(avg(target)*100,2) desc;

-- Experience vs Job_change
select experience, 
count(*) as Total_candidates,
sum(target) as Job_change,
round(avg(target)*100,2) as Job_change_rate
from aug_train_data
group by experience
order by experience;

-- Experience Group vs Job Change Rate
SELECT 
experience_group,
COUNT(*) total_candidates,
SUM(target) job_change,
ROUND(AVG(target)*100,2) job_change_rate
FROM aug_train_data
GROUP BY experience_group
ORDER BY job_change_rate DESC;


